      "timestamps": true
    },
    {
      "entity": "Category",
      "model": "src/app/models/CategoryModel.ts",
      "fields": [
        { "name": "name", "type": "String", "required": true },
        { "name": "description", "type": "String", "required": true },
        { "name": "active", "type": "Boolean", "default": true }
      ],
      "soft_delete": true,
      "timestamps": true
    },
    {
      "entity": "Product",
      "model": "src/app/models/ProductModel.ts",
      "fields": [
        { "name": "name", "type": "String", "required": true },
        { "name": "brand", "type": "String", "required": true },
        { "name": "category", "type": "ObjectId", "ref": "Category", "required": true },
        { "name": "description", "type": "String", "required": true },
        { "name": "purchasePrice", "type": "Number", "required": true, "min": 0 },
        { "name": "price", "type": "Number", "required": true, "min": 0 },
        { "name": "active", "type": "Boolean", "default": true },
        { "name": "images", "type": "String[]" },
        { "name": "variants", "type": "Array", "items": { "size": "Number", "color": "String", "stock": "Number" } }
      ],
      "soft_delete": false,
      "timestamps": true,
      "relationships": [
        { "type": "belongs_to", "target": "Category", "field": "category" }
      ]
    },
    {
      "entity": "Sale",
      "model": "src/app/models/SaleModel.ts",
      "fields": [
        { "name": "customer", "type": "ObjectId", "ref": "User", "required": true },
        { "name": "createdBy", "type": "ObjectId", "ref": "User", "required": true },
        { "name": "date", "type": "Date", "default": "now" },
        { "name": "items", "type": "Array", "items": { "product": "ObjectId", "nameSnapshot": "String", "size": "Number", "color": "String", "quantity": "Number", "unitPrice": "Number", "subtotal": "Number" } },
        { "name": "discount", "type": "Number", "default": 0, "min": 0 },
        { "name": "total", "type": "Number", "required": true, "min": 0 },
        { "name": "paymentMethod", "type": "String", "enum": ["cash", "card", "transfer"], "required": true }
      ],
      "soft_delete": false,
      "timestamps": true,
      "relationships": [
        { "type": "belongs_to", "target": "User", "field": "customer" },
        { "type": "belongs_to", "target": "User", "field": "createdBy" }
      ]
    },
    {
      "entity": "InventoryMovement",
      "model": "src/app/models/InventoryMovementModel.ts",
      "fields": [
        { "name": "product", "type": "ObjectId", "ref": "Product", "required": true },
        { "name": "type", "type": "String", "enum": ["entry", "exit", "adjustment"], "required": true },
        { "name": "size", "type": "Number", "required": true },
        { "name": "color", "type": "String", "required": true },
        { "name": "quantity", "type": "Number", "required": true, "min": 0 },
        { "name": "reason", "type": "String" },
        { "name": "user", "type": "ObjectId", "ref": "User", "required": true },
        { "name": "sale", "type": "ObjectId", "ref": "Sale" }
