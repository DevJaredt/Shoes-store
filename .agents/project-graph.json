      "soft_delete": false,
      "timestamps": true,
      "relationships": [
        { "type": "belongs_to", "target": "Product", "field": "product" },
        { "type": "belongs_to", "target": "User", "field": "user" },
        { "type": "belongs_to", "target": "Sale", "field": "sale" }
      ]
    }
